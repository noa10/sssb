# Copy these values into your hosting environment; never commit real credentials.
NODE_ENV=production
APP_ORIGIN=https://test.semenanjungselatan.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sssb
DB_USER=sssb_node
DB_PASSWORD=
# Use 1 only when Plesk's trusted reverse proxy is the sole route to the app.
TRUST_PROXY=1
CONTACT_EMAIL=info@semenanjungselatan.com
# International digits only; leave blank until confirmed.
WHATSAPP_NUMBER=
# Must be outside the web document root. Set an absolute path on Plesk.
UPLOAD_DIR=
# disabled, mock (local only), or openai-compatible; confirm provider terms first.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_HOURLY_LIMIT=250
